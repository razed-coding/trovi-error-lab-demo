NEXT_PUBLIC_FEMMI_API_KEY=your_api_key_here
# Browser SDK now sends to a same-origin proxy automatically.
# Reference URL for the Femmi cloud dashboard.
NEXT_PUBLIC_FEMMI_DASHBOARD_URL=https://www.femmi.dev
NEXT_PUBLIC_FEMMI_ENV=development
NEXT_PUBLIC_FEMMI_RELEASE=0.1.0
# Optional server-side override for proxy target
FEMMI_UPSTREAM_INGEST_URL=https://www.femmi.dev/api/ingest
