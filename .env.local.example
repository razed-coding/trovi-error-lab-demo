NEXT_PUBLIC_TROVI_API_KEY=your_api_key_here
# Browser SDK now sends to a same-origin proxy automatically.
# Keep this only for reference to Trovi cloud dashboard URL.
NEXT_PUBLIC_TROVI_DASHBOARD_URL=https://www.trovi.dev
NEXT_PUBLIC_TROVI_ENV=development
NEXT_PUBLIC_TROVI_RELEASE=0.1.0
# Optional server-side override for proxy target
TROVI_UPSTREAM_INGEST_URL=https://www.trovi.dev/api/ingest
